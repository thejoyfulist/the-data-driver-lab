{
  "name": "the-data-driver-lab",
  "version": "1.0.0",
  "private": true,
  "description": "Open-source Formula 1 Data Lab built on the public The Data Driver API.",
  "license": "MIT",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs scripts/ai-eval/ai-byok.test.mjs && node scripts/ai-eval/run.mjs --mode mock",
    "eval:ai": "node scripts/ai-eval/run.mjs",
    "eval:ai:truth": "node scripts/ai-eval/build-truth.mjs",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "mcp:stdio": "node scripts/mcp-stdio.mjs"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.74",
    "@ai-sdk/openai-compatible": "^3.0.65",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "ai": "^7.0.130",
    "framer-motion": "^12.36.0",
    "next": "16.3.8",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^22.10.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "10.12.0",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.0.1",
    "globals": "16.4.0",
    "postcss": "8.5.25",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.65.0"
  },
  "overrides": {
    "js-yaml": "4.3.2",
    "eslint-plugin-react-hooks": "7.0.1",
    "minimatch@<=10.0.2": "10.2.6",
    "brace-expansion": "5.0.12",
    "next@16.3.8": {
      "postcss": "8.5.25",
      "sharp": "0.35.5"
    }
  }
}
