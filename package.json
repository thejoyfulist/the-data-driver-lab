{
  "name": "tdd-data-lab",
  "version": "1.0.0",
  "private": true,
  "description": "Open-source Formula 1 Data Lab built on the public The Data Driver API.",
  "license": "MIT",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
