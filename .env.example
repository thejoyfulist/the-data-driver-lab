# Upstream API used by the server page and the /api/f1 proxy.
# Defaults to the public, non-commercial The Data Driver API.
TDD_API_BASE=https://api.thedatadriver.app

# Origin shown when copying an API request, and allowed by the CSP connect-src.
# Usually the same value as TDD_API_BASE. Read at build time.
NEXT_PUBLIC_TDD_API_BASE=https://api.thedatadriver.app

# Source repository linked from the header and footer. Read at build time.
NEXT_PUBLIC_TDD_REPO_URL=https://github.com/thejoyfulist/the-data-driver-lab
